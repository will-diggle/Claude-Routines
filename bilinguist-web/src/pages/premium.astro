---
import Layout from '../layouts/Layout.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import { APP_STORE_URL, DEFAULT_PRICE } from '../lib/config';
---
<Layout title="Premium" description="Unlock the full Bilinguist Brief edition — every language, every level, the full daily briefing.">
  <div class="wrap paywall">
    <h1 class="paywall-headline">Unlock the full edition</h1>
    <p class="tagline paywall-subhead">Read the news in any language. Learn without thinking about it.</p>

    <div class="price-card">
      <p id="price-amount" class="price-amount">{DEFAULT_PRICE.symbol}{DEFAULT_PRICE.amount}</p>
      <p class="price-period">per month · cancel anytime</p>
    </div>

    <div class="comparison">
      <div class="comparison-head">
        <span class="micro-label comparison-head-free">Free</span>
        <span class="micro-label comparison-head-full">Full</span>
      </div>
      <div class="comparison-body">
        <ul class="feature-list feature-list-free">
          <li><span class="check check-free">✓</span> English + 1 language of your choice</li>
          <li><span class="check check-free">✓</span> Any CEFR level</li>
          <li><span class="check check-free">✓</span> 2 Global News stories daily</li>
          <li><span class="check check-free">✓</span> + 1 story from a section you choose</li>
          <li><span class="check check-free">✓</span> Concise articles</li>
        </ul>
        <ul class="feature-list feature-list-full">
          <li><span class="check check-full">✓</span> Full daily briefing (5–15 min read)</li>
          <li><span class="check check-full">✓</span> Every language we publish</li>
          <li><span class="check check-full">✓</span> Concise and long reads</li>
          <li><span class="check check-full">✓</span> Tap any word for instant translation</li>
          <li><span class="check check-full">✓</span> Claude word explanations + IPA</li>
          <li><span class="check check-full">✓</span> Word bank with spaced repetition</li>
          <li><span class="check check-full">✓</span> Flashcards, games &amp; streak tracking</li>
          <li><span class="check check-full">✓</span> Weather strip in your language</li>
        </ul>
      </div>
    </div>

    {/* Subscriptions are sold in the iPhone app (App Store billing via
        RevenueCat); the website unlocks for the same account automatically. */}
    {APP_STORE_URL ? (
      <a id="subscribe-btn" class="subscribe-btn" href={APP_STORE_URL} rel="noopener">Subscribe in the app — <span id="subscribe-price">{DEFAULT_PRICE.symbol}{DEFAULT_PRICE.amount}</span>/month</a>
    ) : (
      <button id="subscribe-btn" class="subscribe-btn" type="button">Subscribe in the app — <span id="subscribe-price">{DEFAULT_PRICE.symbol}{DEFAULT_PRICE.amount}</span>/month</button>
    )}
    <p id="subscribe-note" class="meta-text subscribe-note" hidden={!APP_STORE_URL}>
      {APP_STORE_URL
        ? 'Subscribe in the Bilinguist Brief iPhone app, then sign in here with the same account — the full edition unlocks on the website too.'
        : "Subscriptions are taken in the Bilinguist Brief iPhone app, coming soon to the App Store. Once you've subscribed there, sign in here with the same account and the full edition unlocks on the website too."}
    </p>

    <AppStoreBadge height={44} />

    <a class="restore-link" href="/login">Already subscribed in the app? Sign in with the same account</a>

    <div class="promo-section">
      <button id="promo-toggle" class="promo-toggle" type="button">Have a code?</button>
      <div id="promo-form" class="promo-form" hidden>
        <input id="promo-input" class="promo-input" type="text" placeholder="Enter code" autocapitalize="characters" maxlength="20" />
        <button id="promo-apply" class="promo-apply" type="button">Apply</button>
      </div>
      <p id="promo-result" class="meta-text promo-result" hidden></p>
    </div>
  </div>
</Layout>

<script>
  import { PROMO_CODES } from '../lib/config';

  const priceAmountEl = document.getElementById('price-amount') as HTMLParagraphElement;
  const subscribePriceEl = document.getElementById('subscribe-price') as HTMLSpanElement;

  // The Worker reads the visitor's country at the edge (Cloudflare's `cf`
  // object) and returns the right currency — no geolocation prompt needed.
  // Falls back silently to the page's static default price if unreachable
  // (e.g. local `astro preview`, which doesn't run the Worker).
  fetch('/api/locale-price')
    .then((r) => (r.ok ? r.json() : null))
    .then((price) => {
      if (!price || !price.symbol || !price.amount) return;
      const text = `${price.symbol}${price.amount}`;
      priceAmountEl.textContent = text;
      subscribePriceEl.textContent = text;
    })
    .catch(() => {});

  // Before the App Store listing exists the button explains where to subscribe.
  const subscribeBtn = document.getElementById('subscribe-btn') as HTMLElement;
  const subscribeNote = document.getElementById('subscribe-note') as HTMLParagraphElement;
  if (subscribeBtn.tagName === 'BUTTON') {
    subscribeBtn.addEventListener('click', () => {
      subscribeNote.hidden = false;
    });
  }

  const promoToggle = document.getElementById('promo-toggle') as HTMLButtonElement;
  const promoForm = document.getElementById('promo-form') as HTMLDivElement;
  const promoInput = document.getElementById('promo-input') as HTMLInputElement;
  const promoApply = document.getElementById('promo-apply') as HTMLButtonElement;
  const promoResult = document.getElementById('promo-result') as HTMLParagraphElement;

  promoToggle.addEventListener('click', () => {
    promoForm.hidden = false;
    promoToggle.hidden = true;
    promoInput.focus();
  });

  promoApply.addEventListener('click', () => {
    const code = promoInput.value.trim().toUpperCase();
    const label = PROMO_CODES[code];
    promoResult.hidden = false;
    promoResult.textContent = label
      ? `${code} (${label}) is a valid code — enter it on the paywall in the iPhone app to unlock the full edition.`
      : "That code isn't valid — check it and try again.";
  });
</script>

<style>
  .paywall {
    max-width: 480px;
    padding-block: var(--space-xxl) var(--space-xxl);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-lg);
  }

  .paywall-headline {
    font-size: var(--font-headline);
    line-height: var(--line-headline);
    font-weight: 700;
    color: var(--color-ink-dark);
    margin: 0;
  }

  .paywall-subhead {
    margin: calc(var(--space-lg) * -1) 0 0;
  }

  .price-card {
    width: 100%;
    background: var(--color-accent);
    border-radius: 12px;
    padding-block: var(--space-lg);
  }

  .price-amount {
    font-size: 40px;
    line-height: 46px;
    font-weight: 700;
    color: var(--color-on-accent);
    margin: 0;
  }

  .price-period {
    font-size: 15px;
    color: color-mix(in srgb, var(--color-on-accent) 75%, transparent);
    margin: 0;
  }

  .comparison {
    width: 100%;
    border: var(--hairline-width) solid var(--color-border-light);
    border-radius: 10px;
    overflow: hidden;
    text-align: left;
  }

  .comparison-head {
    display: flex;
    background: var(--color-border-light);
    border-bottom: var(--hairline-width) solid var(--color-hairline);
  }

  .comparison-head span {
    flex: 1;
    text-align: center;
    padding-block: var(--space-sm);
  }

  .comparison-head-free {
    color: var(--color-ink-mid);
  }

  .comparison-head-full {
    color: var(--color-accent);
    font-weight: 700;
  }

  .comparison-body {
    display: flex;
  }

  .feature-list {
    flex: 1;
    list-style: none;
    margin: 0;
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    font-size: 12px;
    line-height: 18px;
  }

  .feature-list-free {
    color: var(--color-ink-light);
    border-right: var(--hairline-width) solid var(--color-border-light);
  }

  .feature-list-full {
    color: var(--color-ink-dark);
  }

  .feature-list li {
    display: flex;
    align-items: flex-start;
    gap: 6px;
  }

  .check {
    flex-shrink: 0;
    font-size: 12px;
    line-height: 18px;
  }

  .check-free {
    color: var(--color-ink-light);
  }

  .check-full {
    color: var(--color-accent);
  }

  .subscribe-btn {
    width: 100%;
    font-family: var(--font-body-family);
    font-size: 17px;
    font-weight: 700;
    color: var(--color-on-accent);
    background: var(--color-accent);
    border: none;
    border-radius: 999px;
    padding-block: var(--space-md);
    cursor: pointer;
  }

  a.subscribe-btn {
    display: block;
    text-align: center;
    text-decoration: none;
    box-sizing: border-box;
  }

  .subscribe-note,
  .restore-note {
    margin: calc(var(--space-md) * -1) 0 0;
  }

  .restore-link {
    font-family: var(--font-body-family);
    font-size: 13px;
    color: var(--color-ink-light);
    text-underline-offset: 3px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .promo-section {
    width: 100%;
    border-top: var(--hairline-width) solid var(--color-border-light);
    padding-top: var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .promo-toggle {
    font-family: var(--font-body-family);
    font-size: 14px;
    color: var(--color-ink-faint);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .promo-form {
    gap: var(--space-sm);
  }

  /* [hidden] must win over display:flex — see the earlier ProfileButton /
     coming-soon-form fix for why an unconditional display here would
     otherwise beat the UA stylesheet's [hidden] rule. */
  .promo-form:not([hidden]) {
    display: flex;
  }

  .promo-input {
    font-family: var(--font-body-family);
    font-size: 15px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-ink-dark);
    background: var(--color-card);
    border: var(--hairline-width) solid var(--color-border-mid);
    border-radius: 999px;
    padding: var(--space-sm) var(--space-md);
    width: 160px;
  }

  .promo-apply {
    font-family: var(--font-body-family);
    font-size: 15px;
    color: var(--color-on-accent);
    background: var(--color-accent);
    border: none;
    border-radius: 999px;
    padding: var(--space-sm) var(--space-lg);
    cursor: pointer;
  }

  .promo-result {
    max-width: 320px;
  }
</style>
