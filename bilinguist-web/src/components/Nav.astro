---
import { FONTS, LANGUAGES, THEMES } from '../lib/config';
---
<header class="nav">
  <div class="wrap nav-row">
    <a href="/" class="wordmark">
      <span class="wordmark-main">Bilinguist Brief</span>
    </a>

    <nav class="links" aria-label="Site">
      <a href="/about" class="micro-label link">About</a>
      <a href="/privacy" class="micro-label link">Privacy</a>
      <a href="/terms" class="micro-label link">Terms</a>
      <button id="prefs-toggle" class="micro-label link prefs-btn" type="button" aria-expanded="false" aria-controls="prefs-panel">
        Preferences
      </button>
    </nav>
  </div>
  <hr class="chrome-rule" />

  <div id="prefs-panel" class="prefs-panel" hidden>
    <div class="wrap prefs-grid">
      <div class="prefs-group">
        <span class="micro-label prefs-label">Theme</span>
        <div class="theme-swatches" role="radiogroup" aria-label="Theme">
          {THEMES.map((t) => (
            <button
              type="button"
              class="swatch"
              data-theme-choice={t.key}
              role="radio"
              aria-checked="false"
              aria-label={t.label}
              title={t.label}
            ></button>
          ))}
        </div>
      </div>

      <div class="prefs-group">
        <label class="micro-label prefs-label" for="language-select">Language</label>
        <select id="language-select" class="prefs-select">
          {LANGUAGES.map((l) => (
            <option value={l.code}>{l.flag} {l.name}</option>
          ))}
        </select>
      </div>

      <div class="prefs-group">
        <label class="micro-label prefs-label" for="level-select">Level</label>
        <select id="level-select" class="prefs-select"></select>
      </div>

      <div class="prefs-group">
        <label class="micro-label prefs-label" for="font-select">Font</label>
        <select id="font-select" class="prefs-select">
          {FONTS.map((f) => (
            <option value={f.key}>{f.label}</option>
          ))}
        </select>
      </div>
    </div>
  </div>
</header>

<script>
  import { LEVELS_BY_LANG, type LanguageCode } from '../lib/config';
  import { applyPreferences, loadPreferences, savePreferences } from '../lib/preferences';

  const prefs = loadPreferences();

  const toggle = document.getElementById('prefs-toggle') as HTMLButtonElement;
  const panel = document.getElementById('prefs-panel') as HTMLDivElement;
  const languageSelect = document.getElementById('language-select') as HTMLSelectElement;
  const levelSelect = document.getElementById('level-select') as HTMLSelectElement;
  const fontSelect = document.getElementById('font-select') as HTMLSelectElement;
  const swatches = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]'));

  function populateLevels(lang: LanguageCode, selected: string) {
    const levels = LEVELS_BY_LANG[lang] ?? [];
    levelSelect.innerHTML = levels
      .map((lvl) => `<option value="${lvl}">${lvl === 'Native' ? 'Native' : lvl}</option>`)
      .join('');
    levelSelect.value = levels.includes(selected as never) ? selected : levels[0];
  }

  function syncSwatches(theme: string) {
    for (const s of swatches) {
      const active = s.dataset.themeChoice === theme;
      s.setAttribute('aria-checked', String(active));
      s.classList.toggle('active', active);
    }
  }

  function dispatchChange() {
    window.dispatchEvent(new CustomEvent('bilinguist:preferences-changed', { detail: prefs }));
  }

  // Initial state
  languageSelect.value = prefs.language;
  populateLevels(prefs.language, prefs.level);
  fontSelect.value = prefs.font;
  syncSwatches(prefs.theme);
  applyPreferences(prefs);

  toggle.addEventListener('click', () => {
    const isHidden = panel.hasAttribute('hidden');
    if (isHidden) panel.removeAttribute('hidden');
    else panel.setAttribute('hidden', '');
    toggle.setAttribute('aria-expanded', String(isHidden));
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (!panel.hasAttribute('hidden') && !panel.contains(target) && !toggle.contains(target)) {
      panel.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
    }
  });

  swatches.forEach((s) => {
    s.addEventListener('click', () => {
      prefs.theme = s.dataset.themeChoice as typeof prefs.theme;
      savePreferences(prefs);
      applyPreferences(prefs);
      syncSwatches(prefs.theme);
      dispatchChange();
    });
  });

  languageSelect.addEventListener('change', () => {
    prefs.language = languageSelect.value as LanguageCode;
    populateLevels(prefs.language, prefs.level);
    prefs.level = levelSelect.value as typeof prefs.level;
    savePreferences(prefs);
    dispatchChange();
  });

  levelSelect.addEventListener('change', () => {
    prefs.level = levelSelect.value as typeof prefs.level;
    savePreferences(prefs);
    dispatchChange();
  });

  fontSelect.addEventListener('change', () => {
    prefs.font = fontSelect.value as typeof prefs.font;
    savePreferences(prefs);
    applyPreferences(prefs);
    dispatchChange();
  });

  const THEME_SWATCH_COLORS: Record<string, string> = {
    white: '#FDFCFB',
    cream: '#F5F0E8',
    softGrey: '#162032',
    night: '#141414',
  };
  for (const s of swatches) {
    const key = s.dataset.themeChoice ?? 'cream';
    s.style.background = THEME_SWATCH_COLORS[key] ?? '#F5F0E8';
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-surface);
  }

  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-md);
  }

  .wordmark {
    text-decoration: none;
    color: var(--color-ink-dark);
    font-weight: 700;
    font-size: clamp(15px, 2vw, 20px);
    letter-spacing: 0.5px;
    white-space: nowrap;
  }

  .links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  @media (max-width: 480px) {
    .nav-row {
      flex-wrap: wrap;
    }

    .links {
      gap: var(--space-md);
      row-gap: var(--space-sm);
    }
  }

  .link {
    text-decoration: none;
    color: var(--color-ink-mid);
    background: none;
    border: none;
    font-family: inherit;
    cursor: pointer;
    padding: 0;
  }

  .link:hover {
    color: var(--color-ink-dark);
  }

  .prefs-btn {
    color: var(--color-chrome);
    font-weight: 700;
  }

  .prefs-panel {
    background: var(--color-card);
    border-bottom: var(--hairline-width) solid var(--color-hairline);
  }

  .prefs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-lg);
    padding-block: var(--space-lg);
  }

  .prefs-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .prefs-label {
    color: var(--color-ink-light);
  }

  .theme-swatches {
    display: flex;
    gap: var(--space-sm);
  }

  .swatch {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: var(--hairline-width) solid var(--color-border-mid);
    cursor: pointer;
    padding: 0;
  }

  .swatch.active {
    outline: 2px solid var(--color-accent-gold);
    outline-offset: 2px;
  }

  .prefs-select {
    font-family: var(--font-body-family);
    font-size: 14px;
    color: var(--color-ink-dark);
    background: var(--color-bg);
    border: var(--hairline-width) solid var(--color-border-mid);
    padding: var(--space-sm);
  }
</style>
