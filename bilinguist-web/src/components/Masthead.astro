---
import { THEMES } from '../lib/config';
---
<a href="/" class="masthead" aria-label="Bilinguist Brief — home">
  {THEMES.map((t) => (
    <img
      src={`/masthead/${t.key}.jpg`}
      alt="Bilinguist Brief"
      class="masthead-img"
      data-masthead-theme={t.key}
      loading="eager"
      fetchpriority="high"
    />
  ))}
</a>
<hr class="chrome-rule" />

<style>
  /* Uses the app's own masthead-compact-*.jpg lockups directly (one flat
     image per theme, background baked in) instead of a tinted mask, for
     pixel-exact parity with what BriefingScreen.tsx renders in the app. */
  .masthead {
    display: flex;
    justify-content: center;
    width: 100%;
    height: clamp(56px, 11vw, 96px);
    background: var(--color-bg);
    text-decoration: none;
  }

  @media (min-width: 900px) {
    .masthead {
      height: clamp(80px, 7vw, 160px);
    }
  }

  .masthead-img {
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: none;
  }

  /* Shown/hidden per theme via [data-theme] on <html> — no JS needed. */
  :global([data-theme='white']) .masthead-img[data-masthead-theme='white'],
  :global([data-theme='cream']) .masthead-img[data-masthead-theme='cream'],
  :global([data-theme='softGrey']) .masthead-img[data-masthead-theme='softGrey'],
  :global([data-theme='night']) .masthead-img[data-masthead-theme='night'] {
    display: block;
  }
</style>
