---
---
<a href="/" class="masthead" aria-label="Bilinguist Brief — home">
  <span class="logotype"></span>
</a>
<hr class="chrome-rule" />

<style>
  .masthead {
    display: flex;
    justify-content: center;
    width: 100%;
    height: clamp(56px, 11vw, 96px);
    background: var(--color-bg);
    text-decoration: none;
  }

  @media (min-width: 900px) {
    .masthead {
      height: clamp(80px, 7vw, 128px);
    }
  }

  /* logotype.png is a black-on-transparent wordmark (no crest) — used as a
     mask so it recolors to each theme's chrome color automatically, the
     same way the app applies tintColor to LOGOTYPE in TopBar.tsx. */
  .logotype {
    display: block;
    width: min(560px, 88%);
    height: 100%;
    background-color: var(--color-chrome);
    -webkit-mask-image: url('/logotype.png');
    mask-image: url('/logotype.png');
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
  }
</style>
