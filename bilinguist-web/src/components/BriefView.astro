---
---
<section class="brief-shell">
  <div class="wrap">
    <div id="brief-loading" class="brief-loading" role="status" aria-live="polite">
      <p id="loading-phrase" class="tagline loading-phrase"></p>
      <div class="skeleton-block">
        <div class="skeleton-line" style="width:30%;height:10px;" data-delay="0"></div>
        <div class="skeleton-line" style="width:90%;height:24px;margin-top:12px;" data-delay="120"></div>
        <div class="skeleton-line" style="width:70%;height:24px;margin-top:8px;" data-delay="240"></div>
        <div class="skeleton-line" style="width:100%;height:16px;margin-top:20px;" data-delay="360"></div>
        <div class="skeleton-line" style="width:100%;height:16px;margin-top:8px;" data-delay="480"></div>
        <div class="skeleton-line" style="width:85%;height:16px;margin-top:8px;" data-delay="600"></div>
      </div>
      <div class="skeleton-block">
        <div class="skeleton-line" style="width:30%;height:10px;" data-delay="200"></div>
        <div class="skeleton-line" style="width:80%;height:24px;margin-top:12px;" data-delay="320"></div>
        <div class="skeleton-line" style="width:100%;height:16px;margin-top:20px;" data-delay="440"></div>
        <div class="skeleton-line" style="width:100%;height:16px;margin-top:8px;" data-delay="560"></div>
        <div class="skeleton-line" style="width:60%;height:16px;margin-top:8px;" data-delay="680"></div>
      </div>
    </div>

    <div id="brief-status" class="brief-status" role="status" aria-live="polite" hidden>
      <p class="micro-label"></p>
    </div>

    <div id="brief-content" class="brief-content" hidden></div>
  </div>
</section>

<script>
  import { loadPreferences } from '../lib/preferences';
  import { fetchBrief, type BriefArticle } from '../lib/brief';
  import { langInfo, translateGenre, genreColor, PHRASE_POOL, type LanguageCode } from '../lib/config';

  const loadingEl = document.getElementById('brief-loading') as HTMLDivElement;
  const statusEl = document.getElementById('brief-status') as HTMLDivElement;
  const contentEl = document.getElementById('brief-content') as HTMLDivElement;
  const phraseEl = document.getElementById('loading-phrase') as HTMLParagraphElement;

  let phraseTimer: ReturnType<typeof setInterval> | null = null;

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function startPhraseCycle(language: LanguageCode) {
    const pool = PHRASE_POOL[language] ?? PHRASE_POOL.en ?? ['Loading…'];
    const shuffled = [...pool].sort(() => Math.random() - 0.5);
    let i = 0;

    const show = () => {
      phraseEl.style.opacity = '0';
      setTimeout(() => {
        phraseEl.textContent = shuffled[i % shuffled.length];
        phraseEl.style.opacity = '1';
        i++;
      }, 160);
    };

    show();
    phraseTimer = setInterval(show, 1600);
  }

  function stopPhraseCycle() {
    if (phraseTimer) clearInterval(phraseTimer);
    phraseTimer = null;
  }

  function showLoading(language: LanguageCode) {
    loadingEl.hidden = false;
    statusEl.hidden = true;
    contentEl.hidden = true;
    startPhraseCycle(language);
  }

  function setStatus(message: string) {
    stopPhraseCycle();
    loadingEl.hidden = true;
    statusEl.hidden = false;
    contentEl.hidden = true;
    statusEl.querySelector('p')!.textContent = message;
  }

  function formatDate(dateStr: string): string {
    try {
      const d = new Date(`${dateStr}T00:00:00Z`);
      return d.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
    } catch {
      return dateStr;
    }
  }

  function renderArticle(article: BriefArticle, language: LanguageCode, index: number, total: number): string {
    const paragraphs = article.body
      .split(/\n\n+/)
      .map((p) => `<p>${escapeHtml(p.trim())}</p>`)
      .join('');

    const genreKey = article.genre.toUpperCase();
    const label = translateGenre(article.genre, language);
    const accent = genreColor(article.genre);

    const genreTag = article.genre
      ? `<p class="micro-label article-genre" style="color:${accent}">${escapeHtml(label)}</p>`
      : '';

    const divider = index < total - 1 ? '<hr class="hairline article-divider" />' : '';

    return `
      <article class="article" data-genre="${escapeHtml(genreKey)}">
        ${genreTag}
        <h2 class="article-headline">${escapeHtml(article.headline)}</h2>
        <div class="article-body">${paragraphs}</div>
      </article>
      ${divider}
    `;
  }

  function applyGenreFilter(genre: string) {
    const articles = contentEl.querySelectorAll<HTMLElement>('.article');
    for (const el of articles) {
      el.style.display = genre === 'all' || el.dataset.genre === genre ? '' : 'none';
    }

    // Dividers sit between two .article elements — hide any divider whose
    // neighbor on either side just got filtered out, so filtering to one
    // genre doesn't leave an orphaned rule with nothing above or below it.
    const dividers = contentEl.querySelectorAll<HTMLElement>('.article-divider');
    for (const hr of dividers) {
      const prev = hr.previousElementSibling as HTMLElement | null;
      const next = hr.nextElementSibling as HTMLElement | null;
      const prevVisible = !!prev && prev.style.display !== 'none';
      const nextVisible = !!next && next.style.display !== 'none';
      hr.style.display = prevVisible && nextVisible ? '' : 'none';
    }
  }

  async function loadAndRender() {
    const prefs = loadPreferences();
    showLoading(prefs.language);

    const result = await fetchBrief(prefs.language, prefs.level, prefs.length);

    if (!result.ok) {
      const message =
        result.reason === 'not_found'
          ? `No brief available yet for ${langInfo(prefs.language).name} at ${prefs.level} level. Try another language or level from the selectors above.`
          : "Couldn't load today's brief — check your connection and try again.";
      setStatus(message);
      return;
    }

    const { brief, date } = result;
    stopPhraseCycle();
    loadingEl.hidden = true;
    statusEl.hidden = true;
    contentEl.hidden = false;

    const edition = `
      <div class="edition-row">
        <span class="micro-label">${escapeHtml(langInfo(prefs.language).name)} · ${escapeHtml(prefs.level)}</span>
        <span class="meta-text">${escapeHtml(formatDate(date))}</span>
      </div>
    `;

    const articlesHtml = brief.articles
      .map((a, i) => renderArticle(a, prefs.language, i, brief.articles.length))
      .join('');

    contentEl.innerHTML = edition + `<div class="columns">${articlesHtml}</div>`;

    // Tell the selector bar which genres are actually present today.
    const seen = new Set<string>();
    const genres: { key: string; label: string }[] = [];
    for (const a of brief.articles) {
      const key = a.genre.toUpperCase();
      if (seen.has(key)) continue;
      seen.add(key);
      genres.push({ key, label: translateGenre(a.genre, prefs.language) });
    }
    window.dispatchEvent(new CustomEvent('bilinguist:brief-genres', { detail: { genres } }));
  }

  loadAndRender();
  window.addEventListener('bilinguist:preferences-changed', () => {
    loadAndRender();
  });
  window.addEventListener('bilinguist:genre-filter-changed', ((e: CustomEvent<{ genre: string }>) => {
    applyGenreFilter(e.detail.genre);
  }) as EventListener);
</script>

<style>
  .brief-shell {
    padding-block: var(--space-lg) var(--space-xxl);
  }

  .brief-loading {
    padding-block: var(--space-xl);
  }

  .loading-phrase {
    text-align: center;
    margin: 0 0 var(--space-xl);
    transition: opacity 0.16s ease;
    min-height: 1.4em;
  }

  .skeleton-block {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: var(--hairline-width) solid var(--color-hairline);
  }

  .skeleton-line {
    border-radius: 4px;
    background: var(--color-border-light);
    overflow: hidden;
    position: relative;
  }

  .skeleton-line::after {
    content: '';
    position: absolute;
    inset: 0;
    transform: translateX(-100%);
    background: linear-gradient(90deg, transparent, var(--color-card), transparent);
    animation: shimmer 1.2s ease-in-out infinite;
    animation-delay: calc(var(--delay, 0) * 1ms);
  }

  @keyframes shimmer {
    100% { transform: translateX(100%); }
  }

  .brief-status {
    padding-block: var(--space-xxl);
    text-align: center;
    color: var(--color-ink-light);
  }

  .edition-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    padding-bottom: var(--space-md);
    border-bottom: var(--hairline-width) solid var(--color-hairline);
    margin-bottom: var(--space-lg);
    color: var(--color-ink-light);
  }

  :global(.columns) {
    column-count: 1;
    column-gap: var(--space-xl);
  }

  @media (min-width: 700px) {
    :global(.columns) {
      column-count: 2;
      column-rule: var(--hairline-width) solid var(--color-hairline);
    }
  }

  :global(.article) {
    margin-bottom: var(--space-lg);
    break-inside: avoid-column;
  }

  :global(.article-genre) {
    margin: 0 0 var(--space-xs);
  }

  :global(.article-headline) {
    font-size: var(--font-headline);
    line-height: var(--line-headline);
    font-weight: 700;
    color: var(--color-ink-dark);
    margin: 0 0 var(--space-sm);
    break-after: avoid-column;
  }

  :global(.article-body p) {
    font-size: var(--font-body);
    line-height: var(--line-body);
    text-align: justify;
    color: var(--color-ink-mid);
    margin: 0 0 var(--space-md);
    hyphens: auto;
  }

  :global(.article-divider) {
    margin: var(--space-lg) 0;
    break-inside: avoid;
  }
</style>

<script is:inline>
  document.querySelectorAll('.skeleton-line').forEach((el) => {
    el.style.setProperty('--delay', el.dataset.delay ?? '0');
  });
</script>
