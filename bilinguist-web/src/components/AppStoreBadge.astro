---
// Apple's "Download on the App Store" badge (black, US English), redrawn to
// Apple's own 119.66×40 geometry. Apple's guidelines don't allow altering the
// badge, so pre-launch it renders unlinked with a caption underneath instead.
import { APP_STORE_URL } from '../lib/config';

interface Props {
  height?: number;
  class?: string;
}

const { height = 48, class: className } = Astro.props;
const width = Math.round((height * 119.66407) / 40);
const Tag = APP_STORE_URL ? 'a' : 'span';
const linkProps = APP_STORE_URL ? { href: APP_STORE_URL, rel: 'noopener' } : { 'aria-disabled': 'true' as const };
---
<span class:list={['app-store-badge', className]}>
  <Tag class="badge-link" aria-label="Download on the App Store" {...linkProps}>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 119.66407 40" width={width} height={height} role="img" aria-hidden="true">
      <rect width="119.66407" height="40" rx="6.5" fill="#A6A6A6" />
      <rect x="0.875" y="0.875" width="117.91407" height="38.25" rx="5.75" fill="#000" />
      <path transform="translate(8.3 8.6) scale(1.1)" fill="#fff" d="M14.1 10.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9C3.6 4.8 2 5.8 1.1 7.4c-1.9 3.2-.5 8 1.3 10.6.9 1.3 1.9 2.7 3.3 2.6 1.3-.1 1.8-.8 3.4-.8 1.6 0 2 .8 3.4.8 1.4 0 2.3-1.3 3.2-2.6 1-1.5 1.4-2.9 1.4-3-.1 0-2.9-1.1-2.9-4.4ZM11.5 3c.7-.9 1.2-2.1 1.1-3.3-1 0-2.3.7-3 1.6-.7.8-1.3 2-1.1 3.2 1.1.1 2.3-.6 3-1.5Z" />
      <text x="35.2" y="14.9" fill="#fff" font-size="8.6" font-weight="500" textLength="42.6" lengthAdjust="spacingAndGlyphs">Download on the</text>
      <text x="34.4" y="30.5" fill="#fff" font-size="17.6" font-weight="600" textLength="70.2" lengthAdjust="spacingAndGlyphs" letter-spacing="-0.2">App Store</text>
    </svg>
  </Tag>
  {!APP_STORE_URL && <span class="badge-soon">Coming soon</span>}
</span>

<style>
  .app-store-badge {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .badge-link {
    display: block;
    line-height: 0;
    border-radius: 8px;
    transition: transform 0.12s ease, opacity 0.12s ease;
  }

  a.badge-link:hover {
    transform: translateY(-1px);
  }

  a.badge-link:active {
    opacity: 0.8;
  }

  .badge-link[aria-disabled] {
    cursor: default;
  }

  svg {
    display: block;
    font-family: -apple-system, 'SF Pro Text', 'SF Pro Display', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .badge-soon {
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-ink-light);
  }
</style>
