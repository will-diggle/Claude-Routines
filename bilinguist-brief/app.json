{
  "expo": {
    "name": "Bilinguist Brief",
    "slug": "bilinguist-brief",
    "scheme": "bilinguistbrief",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-white.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "jsEngine": "jsc",
    "splash": {
      "backgroundColor": "#F5F0E8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bilinguistbrief.app",
      "buildNumber": "97",
      "usesAppleSignIn": true,
      "icon": {
        "light": "./assets/icon-white.png",
        "dark": "./assets/icon-black.png",
        "tinted": "./assets/icon-black.png"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Bilinguist Brief uses your location to show the local weather in your morning briefing.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F0E8"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.bilinguistbrief.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "4f33f632-5650-43d6-881b-4b006eee705f"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-alternate-app-icons",
        [
          { "name": "Black",   "image": "./assets/icon-black.png"   },
          { "name": "Cream",   "image": "./assets/icon-cream.png"   },
          { "name": "Navy",    "image": "./assets/icon-navy.png"    },
          { "name": "Pride1",  "image": "./assets/icon-pride-1.png" },
          { "name": "Pride2",  "image": "./assets/icon-pride-2.png" }
        ]
      ],
      "expo-location",
      ["expo-build-properties", {
        "ios": {
          "useHermes": false,
          "deploymentTarget": "15.1"
        }
      }],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F5F0E8",
          "sounds": []
        }
      ],
      "./plugins/disable-hermes"
    ]
  }
}
