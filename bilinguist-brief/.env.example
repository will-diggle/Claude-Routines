# Copy this file to .env and fill in your keys

# ── Server-side keys (used by scripts/generate-briefings.ts only) ─────────────

# Anthropic — server-side generation script (GitHub Actions)
# Used for: daily briefing generation (Sonnet 4.6 + Haiku 4.5), Batch API
# Requires: web search tool (anthropic-beta: web-search-2025-03-05)
ANTHROPIC_API_KEY=

# Google Gemini — optional A/B test leg (parallel gathering, logged only)
# Used for: Gemini Flash gathering A/B comparison; writing always uses Claude output
# Get key: https://aistudio.google.com/app/apikey (paid tier for search grounding)
# Omit or leave blank to disable Gemini leg and skip gracefully
GEMINI_API_KEY=

# ── Client-side keys (EXPO_PUBLIC_ prefix — bundled into app) ─────────────────
# Anthropic used to be here too (word lookups/tense verification) — moved
# server-side to the Cloudflare Worker (see bilinguist-worker) so the key
# never ships in the app bundle. Don't add server-side keys back to this
# section; anything EXPO_PUBLIC_ is extractable from the compiled app.

# DeepL
# Used for: instant word translation in the word lookup popup
EXPO_PUBLIC_DEEPL_API_KEY=

# Data URL (optional — defaults to GitHub raw content from bilinguist-data repo)
# Override if you're serving via a Cloudflare Worker or custom CDN
EXPO_PUBLIC_DATA_URL=

# OpenWeatherMap
# Used for: weather strip at top of briefing screen
EXPO_PUBLIC_OPENWEATHER_API_KEY=

# RevenueCat
# Used for: subscription paywall management (Stage 5)
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# Firebase
# Used for: user auth, word bank storage, push notifications
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
