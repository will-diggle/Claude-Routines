# Copy this file to .env and fill in your keys

# Anthropic (Claude API)
# Used for: daily briefing generation (Sonnet 4.6), word lookups and games (Haiku 4.5)
# Requires web search tool access: anthropic-beta: web-search-2025-03-05
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# DeepL
# Used for: instant word translation in the word lookup popup
EXPO_PUBLIC_DEEPL_API_KEY=

# OpenWeatherMap
# Used for: weather strip at top of briefing screen
EXPO_PUBLIC_OPENWEATHER_API_KEY=

# RevenueCat
# Used for: subscription paywall management (Stage 5)
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# Firebase
# Used for: user auth, word bank storage, push notifications
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
